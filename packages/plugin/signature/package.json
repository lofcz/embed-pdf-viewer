{
  "name": "@lofcz/embedpdf-plugin-signature",
  "version": "3.0.0-next.12",
  "private": false,
  "description": "Document-scoped digital signing: sign a signature field with a mark (a stamp-library asset or bytes you bring) through a signer port, fill it visually without sealing, validate what is signed, and drop an armed mark onto a field. Owns the act, never a mark — marks are the stamp plugin's.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./contract": {
        "import": "./dist/contract.js",
        "require": "./dist/contract.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:@lofcz/embedpdf-core@*",
    "@embedpdf/core-signature": "workspace:@lofcz/embedpdf-core-signature@*",
    "@embedpdf/engine-core": "workspace:@lofcz/embedpdf-engine-core@*",
    "@embedpdf/plugin-annotation": "workspace:@lofcz/embedpdf-plugin-annotation@*",
    "@embedpdf/plugin-form": "workspace:@lofcz/embedpdf-plugin-form@*",
    "@embedpdf/plugin-interaction": "workspace:@lofcz/embedpdf-plugin-interaction@*",
    "@embedpdf/plugin-stamp": "workspace:@lofcz/embedpdf-plugin-stamp@*"
  },
  "devDependencies": {
    "@embedpdf/engine": "workspace:@lofcz/embedpdf-engine@*",
    "@embedpdf/tooling-build": "workspace:@lofcz/embedpdf-tooling-build@*",
    "typescript": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/embed-pdf-viewer.git",
    "directory": "packages/plugin/signature"
  }
}
