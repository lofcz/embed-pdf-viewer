{
  "name": "@lofcz/embedpdf-plugin-stamp",
  "version": "3.0.0-next.13",
  "private": false,
  "description": "Stamp libraries as PDFs: import Acrobat-compatible libraries (title + /Names /Pages registry), author assets from pages, rasters, or selected annotations, export the library as a complete PDF, and place stamps by pointer or by code through the annotation plugin.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./contract": "./src/contract.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./contract": {
        "import": "./dist/contract.js",
        "require": "./dist/contract.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:@lofcz/embedpdf-core@*",
    "@embedpdf/core-js-sandbox": "workspace:@lofcz/embedpdf-core-js-sandbox@*",
    "@embedpdf/plugin-actions": "workspace:@lofcz/embedpdf-plugin-actions@*",
    "@embedpdf/plugin-annotation": "workspace:@lofcz/embedpdf-plugin-annotation@*",
    "@embedpdf/plugin-form": "workspace:@lofcz/embedpdf-plugin-form@*",
    "@embedpdf/engine-core": "workspace:@lofcz/embedpdf-engine-core@*",
    "@embedpdf/core-acrojs": "workspace:@lofcz/embedpdf-core-acrojs@*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:@lofcz/embedpdf-tooling-build@*",
    "@embedpdf/engine": "workspace:@lofcz/embedpdf-engine@*",
    "@embedpdf/default-stamps": "workspace:@lofcz/embedpdf-default-stamps@*"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/embed-pdf-viewer.git",
    "directory": "packages/plugin/stamp"
  }
}
