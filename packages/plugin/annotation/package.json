{
  "name": "@lofcz/embedpdf-plugin-annotation",
  "version": "3.0.0-next.12",
  "private": false,
  "description": "Annotation feature plugin: the pure annotation-core wired to the engine repository (optimistic create/patch/delete) + the interaction hub (ambient edit + draw tools). Behaviors (forms) plug in here.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./src/index.ts",
    "./authoring": "./src/authoring.ts",
    "./contract": "./src/contract.ts",
    "./contract/host": "./src/host-contract.ts",
    "./internal": "./src/internal.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./authoring": {
        "import": "./dist/authoring.js",
        "require": "./dist/authoring.cjs"
      },
      "./contract": {
        "import": "./dist/contract.js",
        "require": "./dist/contract.cjs"
      },
      "./contract/host": {
        "import": "./dist/contract/host.js",
        "require": "./dist/contract/host.cjs"
      },
      "./internal": {
        "import": "./dist/internal.js",
        "require": "./dist/internal.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "epdf-build",
    "clean": "rimraf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@embedpdf/core": "workspace:@lofcz/embedpdf-core@*",
    "@embedpdf/core-annotation": "workspace:@lofcz/embedpdf-core-annotation@*",
    "@embedpdf/core-geometry": "workspace:@lofcz/embedpdf-core-geometry@*",
    "@embedpdf/plugin-interaction": "workspace:@lofcz/embedpdf-plugin-interaction@*",
    "@embedpdf/plugin-selection": "workspace:@lofcz/embedpdf-plugin-selection@*",
    "@embedpdf/engine-core": "workspace:@lofcz/embedpdf-engine-core@*",
    "@embedpdf/plugin-actions": "workspace:@lofcz/embedpdf-plugin-actions@*",
    "@embedpdf/core-acrojs": "workspace:@lofcz/embedpdf-core-acrojs@*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^2.1.9",
    "@embedpdf/tooling-build": "workspace:@lofcz/embedpdf-tooling-build@*"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lofcz/embed-pdf-viewer.git",
    "directory": "packages/plugin/annotation"
  }
}
